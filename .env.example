# Copy to .env and replace values locally. Never commit .env to Git.
MSSQL_SA_PASSWORD=REPLACE_WITH_EXISTING_SQL_SA_PASSWORD
# Obtain from: docker exec BIOHub id -u  /  docker exec BIOHub id -g
BIOHUB_UID=1654
BIOHUB_GID=1654
# Fill only when moving MVC/Vue under Compose; see docker images.
MVC_IMAGE=biohub-mvc:dev
VUE_IMAGE=biohub-vue:dev
