@model BIOHub.Models.Samples
@{
    ViewData["Title"] = "檢體資訊";
}



<div class="container mt-4">

    <h2>檢體資訊</h2>
    <h5 class="text-muted">受試者編號: @ViewBag.SubjectCode</h5>
    <hr />

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">檢體編號</dt>
                <dd class="col-sm-8">@Model.SampleCode</dd>

                <dt class="col-sm-4">採集日期</dt>
                <dd class="col-sm-8">@Model.CollectionDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">儲存溫度</dt>
                <dd class="col-sm-8">@Model.StorageTemperature.ToString("0.0")°C</dd>

                <dt class="col-sm-4">檢體狀態</dt>
                <dd class="col-sm-8">@(Model.SampleStatus??"未設定")</dd>

                <dt class="col-sm-4">備註</dt>
                <dd class="col-sm-8">@(Model.Remarks??"無")</dd>

                <dt class="col-sm-4">建立時間</dt>
                <dd class="col-sm-8">@Model.CreateAt.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </div>

    </div>

    <div class="mt-3">
        <a asp-controller="Samples"
        asp-action="Index"
        asp-route-subjectId="@ViewBag.SubjectId"
        class="btn btn-secondary">返回檢體列表</a>
        <a asp-controller="Samples"
        asp-action="Edit"
        asp-route-id="@Model.SamplesID"
        class="btn btn-outline-warning">編輯檢體</a>
    </div>

</div>