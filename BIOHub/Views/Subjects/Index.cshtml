@model IEnumerable<BIOHub.Models.Subjects>
@{
    ViewData["Title"] = "受試者管理";
    var items = Model.ToList();
    var projectId = ViewBag.ResearchProjectId;
    var projectName = ViewBag.ProjectName as string;
    int followUp = items.Count(s => s.Status == "FollowUp");
    int completed = items.Count(s => s.Status == "Completed");
}

<div class="bh-subjects container-fluid py-4">
    <div class="bh-subjects-header">
        <div>
            <span class="bh-subjects-eyebrow">BIOHUB / CLINICAL MANAGEMENT</span>
            <h2 class="bh-subjects-title">受試者管理</h2>
            <p class="bh-subjects-muted mb-0">研究計畫：<strong>@(string.IsNullOrWhiteSpace(projectName) ? "目前研究計畫" : projectName)</strong></p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="ResearchProjects" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>返回研究計畫</a>
            <a asp-controller="Subjects" asp-action="Create" asp-route-researchProjectId="@projectId" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>新增受試者</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4"><div class="bh-subjects-stat"><span>受試者總數:</span><strong>@items.Count</strong></div></div>
        <div class="col-6 col-md-4"><div class="bh-subjects-stat"><span>追蹤中(FollowUp):</span><strong>@followUp</strong></div></div>
        <div class="col-6 col-md-4"><div class="bh-subjects-stat"><span>已完成(Completed):</span><strong>@completed</strong></div></div>
    </div>

    <div class="bh-subjects-panel">
        <div class="bh-subjects-panel-head">
            <div><h5 class="mb-1">受試者列表</h5>
                @* <p class="bh-subjects-muted mb-0">搜尋僅篩選目前載入的受試者</p> *@
                </div>
            <div class="bh-subjects-search"><i class="bi bi-search"></i><input id="subjectSearch" type="search" class="form-control" placeholder="搜尋編號、性別或狀態" aria-label="搜尋受試者" /></div>
        </div>
        <div class="table-responsive">
            <table class="table bh-subjects-table align-middle mb-0">
                <thead><tr><th>受試者編號</th><th>性別</th><th>年齡</th><th>生日</th><th>收案日期</th><th>狀態</th><th>操作</th></tr></thead>
                <tbody id="subjectRows">
                @foreach (var item in items)
                {
                    var statusText = item.Status switch { "FollowUp" => "追蹤中", "Completed" => "已完成", "Withdrawn" or "WithDrawn" => "退出研究", _ => item.Status ?? "未設定" };
                    var statusClass = item.Status switch { "FollowUp" => "bh-subjects-pill-primary", "Completed" => "bh-subjects-pill-success", "Withdrawn" or "WithDrawn" => "bh-subjects-pill-muted", _ => "bh-subjects-pill-muted" };
                    <tr class="subject-row" data-search="@($"{item.SubjectCode} {item.Gender} {item.Status} {statusText}".ToLowerInvariant())">
                        <td><span class="bh-subjects-code">@item.SubjectCode</span></td>
                        <td>@(item.Gender == "Male" ? "男性" : item.Gender == "Female" ? "女性" : item.Gender)</td>
                        <td>@item.Age</td>
                        <td>@item.Birth.ToString("yyyy-MM-dd")</td>
                        <td>@item.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="bh-subjects-pill @statusClass">@statusText</span></td>
                        <td><div class="bh-subjects-actions">
                            <a asp-controller="Subjects" asp-action="Details" asp-route-id="@item.SubjectsID" class="btn btn-sm btn-outline-primary">詳細</a>
                            <a asp-controller="Subjects" asp-action="Edit" asp-route-id="@item.SubjectsID" class="btn btn-sm btn-outline-secondary">編輯</a>
                            <a asp-controller="Subjects" asp-action="Delete" asp-route-id="@item.SubjectsID" class="btn btn-sm btn-outline-danger">刪除</a>
                            <a asp-controller="ClinicalData" asp-action="Index" asp-route-subjectId="@item.SubjectsID" class="btn btn-sm btn-light border">臨床資料</a>
                            <a asp-controller="SurvivalData" asp-action="Index" asp-route-subjectId="@item.SubjectsID" class="btn btn-sm btn-light border">存活資料</a>
                            <a asp-controller="Samples" asp-action="Index" asp-route-subjectId="@item.SubjectsID" class="btn btn-sm btn-light border">檢體管理</a>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="p-4 text-center bh-subjects-muted @(items.Count > 0 ? "d-none" : "")" id="subjectEmpty">目前沒有受試者資料，可點選「新增受試者」建立第一筆資料。</div>
        <div class="p-4 text-center bh-subjects-muted d-none" id="subjectNoMatches">沒有符合搜尋條件的受試者。</div>
    </div>
</div>
@section Scripts {
<script>
(() => {
    const input = document.getElementById('subjectSearch');
    const rows = [...document.querySelectorAll('#subjectRows .subject-row')];
    const noMatches = document.getElementById('subjectNoMatches');
    if (!input) return;
    input.addEventListener('input', () => {
        const term = input.value.trim().toLocaleLowerCase();
        let visible = 0;
        rows.forEach(row => {
            const match = row.dataset.search.includes(term);
            row.classList.toggle('d-none', !match);
            if (match) visible++;
        });
        noMatches.classList.toggle('d-none', rows.length === 0 || visible !== 0);
    });
})();
</script>
}
