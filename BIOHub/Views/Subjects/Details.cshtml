@model BIOHub.Models.Subjects

@{
    ViewData["Title"] = "受試者詳細資料";
}

<h2>受試者詳細資料</h2>

<h5>研究計畫:@ViewBag.ProjectName</h5>

<dl class="row">
    <dt class="col-sm-3">編號</dt>
    <dd class="col-sm-9">@Model.SubjectCode</dd>

    <dt class="col-sm-3">性別</dt>
    <dd class="col-sm-9">@Model.Gender</dd>

    <dt class="col-sm-3">生日</dt>
    <dd class="col-sm-9">@Model.Birth.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">年齡</dt>
    <dd class="col-sm-9">@Model.Age</dd>

    <dt class="col-sm-3">收案日期</dt>
    <dd class="col-sm-9">@Model.EnrollmentDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">狀態</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<a asp-action="Index"
   asp-route-researchProjectID="@ViewBag.ResearchProjectId"
class="btn btn-secondary">
    返回受試者列表
</a>