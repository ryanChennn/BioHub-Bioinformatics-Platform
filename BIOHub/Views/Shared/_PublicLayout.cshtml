<body class="bg-surface font-body-md text-body-md text-on-surface antialiased">
<header class="fixed top-0 inset-x-0 z-50 bg-surface-container-lowest/90 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="h-20 max-w-7xl mx-auto px-gutter flex items-center justify-between gap-space-md">
       
        
        <div class="flex items-center gap-space-sm">
            <img alt="BioHub Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1XRFvxZ_VeVXTjjB0obj0ROtjkbbIlBY0S-_xklq8XRpimLlrOYAvRRWqrf9uWYzh3DUdRC696QiTeJHlGHAcphvmkx269DbgSQf0ragCeIOGUksFuZckS8Mxg3W0Z8R7muuAvepLUWuSAg9zfUR0BU0XrT61jFKEiw_WLw3ghnX2_tu9C_njFJYTceU1VHcAOz-U0XbT9alT3QrPH7JBldgUtr2HTKcg3ZZTRIXvxhRJIMcSJ7cdynxGCR"/><span class="font-headline-sm text-headline-sm tracking-tight text-on-surface font-bold">BioHub</span>
            <span class="hidden lg:inline-flex items-center px-space-xs py-0.5 rounded-full bg-secondary-container/30 text-on-secondary-container font-label-sm text-label-sm uppercase tracking-wider">Research Core</span></div>
            <nav class="hidden xl:flex items-center gap-space-xs" data-active-classes="bg-surface-container-high text-primary font-label-lg rounded-lg">
                <a aria-current="page" 
                asp-action="Index" 
                asp-controller="Home"
                class="px-space-sm py-space-xs transition-colors bg-surface-container-high text-primary font-label-lg rounded-lg flex items-center gap-1" data-path="home">Home
            </a>

                <div class="relative group"><button class="px-space-sm py-space-xs rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors inline-flex items-center gap-1" data-path="platform">Platform <span class="material-symbols-outlined text-[16px] text-outline group-hover:rotate-180 transition-transform">keyboard_arrow_down</span></button>
                    <div class="absolute left-0 top-full mt-1 hidden group-hover:flex flex-col bg-surface-container-lowest rounded-xl shadow-xl p-space-xs w-64 border border-outline-variant/30 z-50"><a class="px-space-sm py-2 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-low flex flex-col" href="#platform"><span class="font-bold text-on-surface">Research Management</span><span class="text-xs text-on-surface-variant font-normal">Clinical protocols &amp; cohort cohorts</span></a><a class="px-space-sm py-2 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-low flex flex-col" href="#platform">
                <span class="font-bold text-on-surface">Sample Management</span>
                <span class="text-xs text-on-surface-variant font-normal">Cold-chain &amp; 2D DataMatrix tracking
                    </span>
                    </a>
                    <a class="px-space-sm py-2 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-low flex flex-col" href="#platform"><span class="font-bold text-on-surface">RNA-seq Analysis</span><span class="text-xs text-on-surface-variant font-normal">Cloud Nextflow &amp; DESeq2 pipelines</span></a></div></div><a class="px-space-sm py-space-xs rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="laboratory-services" href="#laboratory-services">Laboratory Services</a><a class="px-space-sm py-space-xs rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="about-biohub" href="#about">About BioHub</a></nav>
                    <div class="flex items-center gap-space-sm"><a asp-action="Login" asp-controller="Account" class="hidden sm:inline-flex items-center px-space-md py-space-xs font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container rounded-lg transition-colors" data-path="login">Login</a><a asp-action="Register" asp-controller="Account" class="inline-flex items-center justify-center px-space-md py-space-xs rounded-lg font-label-lg text-label-lg bg-primary text-on-primary hover:bg-primary-container transition-colors shadow-sm" data-path="register">Get Started</a><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div>
                        <details class="relative xl:hidden"><summary class="list-none p-space-xs rounded-lg text-on-surface-variant hover:bg-surface-container cursor-pointer flex items-center justify-center"><span class="material-symbols-outlined text-[24px]">menu</span></summary><div class="absolute right-0 mt-space-sm w-64 p-space-sm bg-surface-container-lowest rounded-xl shadow-[0_10px_25px_-5px_rgba(30,41,59,0.08)] flex flex-col gap-space-xs"><a asp-action="Index" asp-controller="Home" class="px-space-md py-space-xs rounded-lg font-label-lg text-label-lg bg-surface-container-high text-primary transition-colors" data-path="home">Home</a>
                            <div class="px-space-md pt-2 pb-1 text-xs font-semibold text-outline uppercase tracking-wider">Platform Modules</div><a class="px-space-md py-space-xs rounded-lg font-body-sm text-on-surface hover:bg-surface-container transition-colors pl-6" data-path="research-management" href="#platform">Research Management</a><a class="px-space-md py-space-xs rounded-lg font-body-sm text-on-surface hover:bg-surface-container transition-colors pl-6" data-path="sample-management" href="#platform">Sample Management</a>
                            <a class="px-space-md py-space-xs rounded-lg font-body-sm text-on-surface hover:bg-surface-container transition-colors pl-6" data-path="rna-seq-analysis" href="#platform">RNA-seq Analysis</a><a class="px-space-md py-space-xs rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" data-path="laboratory-services" href="#laboratory-services">Laboratory Services</a><a class="px-space-md py-space-xs rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" data-path="about-biohub" href="#about">About BioHub</a>
                            <div class="h-px bg-surface-variant my-space-xs"></div>
                                <a asp-action="Login" asp-controller="Account" class="px-space-md py-space-xs rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors sm:hidden" data-path="login">Login

                        </a>
                        </div>
                        </details>
                        </div>
                        </div>

                        </header>

@RenderBody()

<footer class="w-full bg-surface-container-low shadow-[0_-1px_6px_rgba(0,0,0,0.02)]"><div class="max-w-7xl mx-auto px-gutter pt-space-xl pb-space-lg"><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-space-lg mb-space-xl">
    <div class="lg:col-span-2 flex flex-col gap-space-md">
        <div class="flex items-center gap-space-sm">
            <img alt="BioHub Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1XRFvxZ_VeVXTjjB0obj0ROtjkbbIlBY0S-_xklq8XRpimLlrOYAvRRWqrf9uWYzh3DUdRC696QiTeJHlGHAcphvmkx269DbgSQf0ragCeIOGUksFuZckS8Mxg3W0Z8R7muuAvepLUWuSAg9zfUR0BU0XrT61jFKEiw_WLw3ghnX2_tu9C_njFJYTceU1VHcAOz-U0XbT9alT3QrPH7JBldgUtr2HTKcg3ZZTRIXvxhRJIMcSJ7cdynxGCR"/><span class="font-headline-sm text-headline-sm tracking-tight text-on-surface font-bold">BioHub</span></div>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-sm leading-relaxed">Connecting clinical research protocols, longitudinal biospecimens, and RNA-seq bioinformatics into one integrated platform.</p><div class="flex flex-wrap items-center gap-space-sm mt-space-xs"><div class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-surface-container-lowest text-tertiary font-label-md text-label-md shadow-sm border border-outline-variant/30"><span class="material-symbols-outlined text-[16px]">verified_user</span>Research Workflow</div><div class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-surface-container-lowest text-secondary font-label-md text-label-md shadow-sm border border-outline-variant/30"><span class="material-symbols-outlined text-[16px]">lock</span>Privacy-conscious</div></div></div><div class="flex flex-col gap-space-sm"><span class="font-label-lg text-label-lg text-on-surface font-semibold tracking-wide">Platform</span><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="research-management" href="#platform">Research Management</a><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="sample-management" href="#platform">Sample Management</a><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="rna-seq-analysis" href="#platform">RNA-seq Analysis</a></div><div class="flex flex-col gap-space-sm"><span class="font-label-lg text-label-lg text-on-surface font-semibold tracking-wide">Services</span><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="laboratory-services" href="#laboratory-services">Laboratory Services</a><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="bioinformatics-services" href="#laboratory-services">Bioinformatics Services</a></div><div class="flex flex-col gap-space-sm"><span class="font-label-lg text-label-lg text-on-surface font-semibold tracking-wide">Resources</span><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="about-biohub" href="#about">About BioHub</a><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="contact" href="#">Documentation</a><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="contact" href="#">Contact Core Team</a></div><div class="flex flex-col gap-space-sm"><span class="font-label-lg text-label-lg text-on-surface font-semibold tracking-wide">Account</span><a asp-action="Login" asp-controller="Account" class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="login">Login</a><a asp-action="Register" asp-controller="Account" class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="register">Request Pilot Access</a></div></div><div class="pt-space-md bg-surface-container-low flex flex-col md:flex-row items-center justify-between gap-space-md"><p class="font-body-sm text-body-sm text-on-surface-variant text-center md:text-left">© @DateTime.Now.Year BioHub — Bioinformatics &amp; Clinical Research Management Platform. All rights reserved.</p><div class="flex flex-wrap items-center justify-center gap-space-md"><a class="font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-colors" data-path="privacy-policy" href="#">Privacy Policy</a><a class="font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-colors" data-path="terms-of-service" href="#">Terms of Service</a><span class="font-label-sm text-label-sm text-on-surface-variant px-space-xs py-0.5 rounded bg-surface-container text-on-surface">Audit-ready</span></div></div></div></footer>

<script src="~/js/biohub-public.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
