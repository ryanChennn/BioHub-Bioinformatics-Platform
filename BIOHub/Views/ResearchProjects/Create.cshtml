@model BIOHub.Models.ResearchProjects
@{
    ViewData["Title"] = "新增研究計畫";
}
<div class="bh-research container-fluid py-3 py-lg-4">
    <div class="bh-research-header">
        <div><div class="bh-research-eyebrow"><i class="bi bi-folder-plus me-2"></i>RESEARCH MANAGEMENT</div><h1 class="bh-research-title">新增研究計畫</h1><p class="bh-research-subtitle mb-0">建立研究計畫的基本資訊，後續即可管理受試者與檢體。</p></div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>返回列表</a>
    </div>
    <div class="bh-research-card bh-research-form-card">
        <div class="bh-research-card-header"><h2 class="bh-research-section-title">計畫基本資料</h2><p class="bh-research-subtitle mb-0">標示 * 的欄位為必填</p></div>
        <form asp-controller="ResearchProjects" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="bh-research-card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-4">
                    <div class="col-12 col-lg-6"><label asp-for="ProjectCode" class="form-label">計畫編號 <span class="text-danger">*</span></label><input asp-for="ProjectCode" class="form-control" placeholder="例如：BIO-2026-001" /><span asp-validation-for="ProjectCode" class="text-danger small"></span></div>
                    <div class="col-12 col-lg-6"><label asp-for="ProjectName" class="form-label">計畫名稱 <span class="text-danger">*</span></label><input asp-for="ProjectName" class="form-control" placeholder="請輸入研究計畫名稱" /><span asp-validation-for="ProjectName" class="text-danger small"></span></div>
                    <div class="col-12"><label asp-for="Description" class="form-label">研究計畫說明</label><textarea asp-for="Description" class="form-control" rows="4" placeholder="說明研究目標與內容（選填）"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
                    <div class="col-12 col-lg-6"><label asp-for="PrincipalInvestigator" class="form-label">計畫主持人</label><input asp-for="PrincipalInvestigator" class="form-control" /><span asp-validation-for="PrincipalInvestigator" class="text-danger small"></span></div>
                    <div class="col-12 col-lg-6"><label asp-for="Institution" class="form-label">研究機構</label><input asp-for="Institution" class="form-control" /><span asp-validation-for="Institution" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="StartDate" class="form-label">開始日期</label><input asp-for="StartDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /><span asp-validation-for="StartDate" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="EndDate" class="form-label">結束日期</label><input asp-for="EndDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger small"></span></div>
                    <div class="col-12 col-lg-6"><label asp-for="ProjectStatus" class="form-label">計畫狀態</label><select asp-for="ProjectStatus" class="form-select"><option value="">請選擇狀態</option><option value="Planning">申請中</option><option value="Active">進行中</option><option value="Complete">已結束</option><option value="Cancelled">已取消</option></select><span asp-validation-for="ProjectStatus" class="text-danger small"></span></div>
                </div>
                <div class="bh-research-note mt-4"><i class="bi bi-shield-check me-2"></i>申請人、建立時間與所屬帳號應由後端依登入身分自動設定，不由使用者輸入。</div>
            </div>
            <div class="bh-research-form-footer"><a asp-action="Index" class="btn btn-light">取消</a><button type="submit" class="btn btn-primary bh-research-primary"><i class="bi bi-check2 me-1"></i>建立研究計畫</button></div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
