@model IEnumerable<BIOHub.ViewModels.AnalysisJobListViewModel>
@using BIOHub.Helpers
@{
    ViewData["Title"] = "RNAseq分析";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">RNAseq Analysis Jobs</h2>
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }
            <p>管理 RNA-seq 差異表現分析工作</p>
        </div>

        <a asp-controller="AnalysisJob"
           asp-action="Create"
           class="btn btn-primary">新增分析工作</a>
    </div>
    
    @if (ViewBag.ResearchProjectId != null)
    {
        <div class="alert alert-primary d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <i class="bi bi-funnel-fill me-2"></i>
                目前研究計畫:
                <strong>@ViewBag.FilterProjectName</strong>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="ResearchProjects"
                   asp-action="Details"
                   asp-route-id="@ViewBag.ResearchProjectId"
                   class="btn btn-sm btn-outline-primary">
                    返回研究計畫
                </a>

                <a asp-controller="AnalysisJob"
                   asp-action="Index"
                   class="btn btn-sm btn-primary">顯示全部分析工作</a>
            </div>
        </div>
        
    }



    @if (!Model.Any())
    {
        <div class="alert alert-info">目前尚未建立分析工作。</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>分析名稱</th>
                        <th>研究計畫</th>
                        <th>分析方法</th>
                        <th>操作</th>
                        <th>狀態</th>
                        <th>建立時間</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.JobName</td>
                            <td>@item.ProjectName</td>
                            <td>@item.AnalysisMethod</td>

                            @*                             查詢資料是否有進去:
                            <td>
    <div>JobStatus：@item.JobStatus</div>
    <div>HasCountsMatrix：@item.HasCountMatrix</div>
    <div>HasSampleMetadata：@item.HasSampleMetadata</div>
    <div>HasFiles：@item.HasFiles</div>
</td> *@
                            <td>
                                <div class="d-flex gap-2 flex-wrap">

                                    @if (item.JobStatus == "Pending")
                                    {
                                        if (!item.HasFiles)
                                        {
                                            <a asp-controller="AnalysisJob"
                                               asp-action="Upload"
                                               asp-route-id="@item.AnalysisJobID"
                                               class="btn btn-outline-primary btn-sm">
                                                上傳 CSV檔
                                            </a>
                                        }
                                        else
                                        {
                                            <form asp-controller="AnalysisJob"
                                                  asp-action="Run"
                                                  asp-route-id="@item.AnalysisJobID"
                                                  method="post"
                                                  class="analysis-run-form">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    執行分析
                                                </button>
                                            </form>
                                        }

                                    }
                                    else if (item.JobStatus == "Queued")
                                    {
                                        <button class="btn btn-info btn-sm text-dark"
                                                disabled>
                                            等待分析中...
                                        </button>
                                    }
                                    else if (item.JobStatus == "Running")
                                    {
                                        <button class="btn btn-secondary btn-sm"
                                                disabled>
                                            分析中...
                                        </button>
                                    }
                                    else if (item.JobStatus == "Completed")
                                    {
                                        <a asp-controller="AnalysisJob"
                                           asp-action="Details"
                                           asp-route-id="@item.AnalysisJobID"
                                           class="btn btn-primary btn-sm">
                                            查看結果
                                        </a>
                                    }
                                    else if (item.JobStatus == "Failed")
                                    {
                                        <a asp-controller="AnalysisJob"
                                           asp-action="Details"
                                           asp-route-id="@item.AnalysisJobID"
                                           class="btn btn-outline-danger btn-sm">
                                            查看錯誤
                                        </a>
                                    }

                                </div>

                            </td>
                            <td>
                                @switch (item.JobStatus)
                                {
                                    case "Pending":
                                        <span class="badge bg-secondary ">
                                            Pending
                                        </span>
                                        break;
                                    case "Queued":
                                        <span class="badge bg-info text-dark">
                                            Queued
                                        </span>
                                        break;

                                    case "Running":
                                        <span class="badge bg-primary ">
                                            Running
                                        </span>
                                        break;

                                    case "Completed":
                                        <span class="badge bg-success ">
                                            Completed
                                        </span>
                                        break;

                                    case "Failed":
                                        <span class="badge bg-danger ">
                                            Failed
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-secondary ">
                                            @item.JobStatus
                                        </span>
                                        break;


                                }
                            </td>

                            <td>
                                @DateTimeHelper.ToTaiwanTime(item.CreateAt).ToString("yyyy-MM-dd HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts{
    <script>
                          
        document.querySelectorAll(".analysis-run-form")
            .forEach(form => {
                form.addEventListener("submit", function (event) {
                    if (form.dataset.submitted === "true") {
                        event.preventDefault();
                        return;
                    }

                    form.dataset.submitted = "true";

                    const button = form.querySelector("button");

                    if (button) {
                        button.disabled = true;
                        button.textContent = "加入佇列中...";
                    }
                });
            });

    </script>

}