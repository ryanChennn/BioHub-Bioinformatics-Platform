@using BIOHub.Helpers
@model BIOHub.ViewModels.AnalysisJobDetailsViewModel
@{
    ViewData["Title"] = "RNA-seq分析結果";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">RNAseq Analysis Results</h2>
            <p class="text-muted mb-0">查看DESeq2差異表現分析結果</p>
        </div>
        <a asp-controller="AnalysisJob"
        asp-action="Index"
        class="btn btn-outline-secondary">返回分析工作</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">分析工作資訊</h5>
        </div>
        <div class="card-body">
            <div class="col-md-6">
                <strong>分析名稱:</strong>
                @Model.JobName
            </div>

            <div class="col-md-6">
                <strong>分析方法:</strong>
                @Model.AnalysisMethod
            </div>

            <div class="col-md-6">
                <strong>分析狀態:</strong>
                @if(Model.JobStatus == "Completed")
                {
                    <span class="badge bg-success">Completed</span>
                }
                else if(Model.JobStatus == "Failed")
                {
                    <span class="badge bg-danger">Failed</span>
                }
                else if(Model.JobStatus == "Running")
                {
                    <span class="badge bg-primary">Running</span>
                }
                else
                {
                    <span class="badge bg-secondary">Pending</span>
                }
            </div>

            <div class="col-md-6">
                <strong>Control:</strong>
                @Model.ControlGroup
            </div>

            <div class="col-md-6">
                <strong>Treatment:</strong>
                @Model.TreatmentGroup
            </div>

            <div class="col-md-6">
                <strong>建立時間(UTC):</strong>
                @(Model.StartAt.HasValue
    ? DateTimeHelper.ToTaiwanTime(Model.StartAt.Value)
        .ToString("yyyy-MM-dd HH:mm:ss")
    : "尚未開始")
            </div>

            <div class="col-md-6">
                <strong>完成時間(UTC):</strong>
                @(Model.FinishAt.HasValue
    ? DateTimeHelper.ToTaiwanTime(Model.FinishAt.Value)
        .ToString("yyyy-MM-dd HH:mm:ss")
    : "尚未完成")
            </div>







        </div>
    </div>



@if(Model.JobStatus == "Completed" && Model.HasResult)
{
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted">Total Genes</p>
                    <h2 class="fw-bold">
                        @(Model.TotalGenes?.ToString("N0") ?? "N/A")
                    </h2>
                </div>
            </div>
        </div>


        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted"> Significant Genes</p>
                    <h2 class="fw-bold text-danger">@(Model.SignificantGenes?.ToString("N0")??"N/A")</h2>
                </div>
            </div>
        </div>
    </div>


    
<section class="card shadow-sm mb-4" id="volcanoSection">

    <div class="card-header bg-white">
        <h5 class="mb-0">互動式 Volcano Plot</h5>
    </div>

    <div class="card-body">

        <div id="volcanoExplorer"
             data-url="@Url.Action("VolcanoData", "AnalysisJob",
                       new { id = Model.AnalysisJobID })">

            <div class="row g-3 mb-3 align-items-end">

                <div class="col-sm-4 col-lg-3">
                    <label for="volcanoPadj" class="form-label">
                        padj 門檻
                    </label>
                    <input id="volcanoPadj"
                           class="form-control"
                           type="number"
                           min="0.0000001"
                           max="1"
                           step="any"
                           value="0.05" />
                </div>

                <div class="col-sm-4 col-lg-3">
                    <label for="volcanoFc" class="form-label">
                        |log2FC| 門檻
                    </label>
                    <input id="volcanoFc"
                           class="form-control"
                           type="number"
                           min="0"
                           step="any"
                           value="1" />
                </div>

                <div class="col-sm-4 col-lg-3">
                    <button id="volcanoReset"
                            class="btn btn-outline-primary w-100"
                            type="button">
                        重設門檻
                    </button>
                </div>

            </div>

            <p id="volcanoMessage"
               class="small text-muted"
               role="status">
                準備載入圖表…
            </p>

            <div id="volcanoPlot"
                 class="biohub-volcano-plot">
            </div>

            <div class="row g-2 mt-2 align-items-end">

                <div class="col-md-7">
                    <label for="volcanoGeneSearch"
                           class="form-label">
                        搜尋 GeneSymbol / GeneID
                    </label>
                    <input id="volcanoGeneSearch"
                           type="search"
                           class="form-control"
                           placeholder="例如 TP53"
                           autocomplete="off" />
                </div>

                <div class="col-6 col-md-auto">
                    <button id="volcanoSearchBtn"
                            type="button"
                            class="btn btn-primary w-100">
                        搜尋基因
                    </button>
                </div>

                <div class="col-6 col-md-auto">
                    <button id="volcanoClearSearch"
                            type="button"
                            class="btn btn-outline-secondary w-100">
                        清除搜尋
                    </button>
                </div>

            </div>

            <div id="volcanoSearchResult"
                 class="alert alert-light border mt-3"
                 role="status"
                 aria-live="polite">
                請輸入 GeneSymbol 或 GeneID，
                搜尋結果將以橘色標示。
            </div>

        </div>
    </div>
</section>



