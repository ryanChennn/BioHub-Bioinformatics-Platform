@* AJAX DEG Explorer *@
<div id="degExplorer"
    class="card shadow-sm mb-4"
data-job-id="@Model.AnalysisJobID"
data-api-url="@Url.Action("GetDegResults", "AnalysisJob")">

<div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
<div>
    <h5 class="mb-1">DEG Explorer</h5>
    <small class="text-muted">搜尋、篩選與排序差異表現基因</small>
</div>
<button type="button"
    id="degExportCsv"
class="btn btn-success btn">
<i class="bi bi-download"></i>
下載篩選結果
</button>
<button type="button"
    id="degResetAll"
class="btn btn-outline-secondary btn-sm">
清除所有的條件
</button>
</div>

<div class="card-body">
    <div id="degError"
        class="alert alert-danger d-none"
    role="alert">

    </div >

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <span class="text-muted">符合條件:</span>
            <strong id="degTotalCount">--</strong>
            <span class="text-muted">筆基因</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label for="degPageSize" class="mb-0"> 每頁顯示</label>

        <select id="degPageSize"
            class="form-select form-select-sm"
        style="width:auto">
        <option value="10">10</option>
        <option value="20" selected>20</option>
        <option value="50">50</option>

        </select>
           </div>
    </div>

    <div id="degFilterPanel" class="border bg-light p-3 mb-3 d-none"></div>
    <div id="degLoading"
        class="text-center py-3 d-none"
    role="status">
    <div class="spinner-border text-bg-danger" aria-hidden="true"></div>
    <div class="mt-2">正在查詢基因資料...</div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm align-middle deg-table-compact" id="degTable">
            <thead class="table-light" id="degTableHead"></thead>
            <tbody id="degTableBody"></tbody>

        </table>

    </div>

    <div id="degEmpty"
        class="alert alert-info d-none"
    role="status">
    沒有符合目前條件的基因
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <span id="degPageInfo" class="text-muted">第1頁</span>
        <div class="btn-group" role="group" aria-label="DEG分頁">
            <button type="button"
                id="degPrevious"
            class="btn btn-outline-primary btn-sm">
                上一頁
            </button>
            <button type="button"
                id="degNext"
            class="btn btn-outline-primary btn-sm">
                下一頁
            </button>
        </div>
    </div>
</div>
</div>










<div class="card shadow-sm">
    <div class="card-body">
        <h5>下載分析結果</h5>
            <p class="text-muted">下載DESeq2差異表現分析結果</p>
            <a asp-controller="AnalysisJob"
            asp-action="ResultFile"
            asp-route-id="@Model.AnalysisJobID"
            asp-route-type = "csv"
               class="btn btn-primary">
                下載 DEG_results.csv
            </a>
    </div>
</div>


}else if(Model.JobStatus == "Completed")
{
    <div class="alert alert-warning">
        分析工作已標記為 Completed，
        但找不到分析結果紀錄
    </div>
}
else
{
    <div class="alert alert-info">
        此分析工作尚未產生可查看的結果
    </div>
}
</div>

 @section Scripts{
 <script src="~/js/deg-explorer.js"
 asp-append-version="true"></script>
 <script  src="https://cdn.plot.ly/plotly-4.1.1.min.js"></script>
<script src="~/js/biohub-volcano.js"
        asp-append-version="true"></script>

 }